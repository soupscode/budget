[Unit]
Description=Budget (self-hosted budget app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=budget
Group=budget
WorkingDirectory=/opt/budget
Environment=BUDGET_DB=/var/lib/budget/budget.db
Environment=BUDGET_HOST=0.0.0.0
Environment=BUDGET_PORT=8080
ExecStart=/usr/bin/python3 /opt/budget/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/budget

[Install]
WantedBy=multi-user.target
